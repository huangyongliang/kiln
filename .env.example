# 复制为 .env 后按本地环境修改。不要把真实密钥写进仓库。
# .env 已被 git 忽略。下列口令只是本地开发默认值，不能用于生产。

KILN_ENV=local
KILN_HTTP_HOST=0.0.0.0
KILN_HTTP_PORT=8000
KILN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# API 启动时连接该库并执行迁移。此默认值与 docker compose 中的本地 Postgres 对齐。
DATABASE_URL=postgresql://kiln:kiln@localhost:5432/kiln

# 调用 /api/v1 时放在 Authorization: Bearer 头里。
# kiln-local 只用于本地开发和 CI，不能用于生产。留空时 API 拒绝启动。
KILN_API_TOKEN=kiln-local
POSTGRES_USER=kiln
POSTGRES_PASSWORD=kiln
POSTGRES_DB=kiln

# openai：调用 LLM_BASE_URL 上的 OpenAI 兼容 /chat/completions
# mock：本地固定回复，不访问网络，也不调用工具。不能起草 Skill 或发起构建。
# off：关闭模型（none、disabled 同样视为关闭）
LLM_PROVIDER=off
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Jenkins 兼容执行器。三项都留空则不连接，API 仍能启动。
# 走通产品构建时填写这里的执行器变量，并配置下面的代码源。KILN_NEXUS_* 留空。
# 不要把真实令牌写进仓库。URL 不能带用户名或口令。
# 共享实验机上已经在跑的 Jenkins 是 http://127.0.0.1:8080 ，口令不在本文件里。
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_TIMEOUT_SECONDS=30

# 代码源适配器。off 表示不连接。
# gitea：实验室实现。gitlab：生产代码源。仓库不提供这两处的生产地址。
# 共享实验机上已经在跑的 Gitea 是 http://127.0.0.1:3000 ，令牌不在本文件里。
GIT_PROVIDER=off
GIT_BASE_URL=
# Jenkins 用来克隆的代码源根地址。留空则使用 GIT_BASE_URL。
# 当 API 和 Jenkins 不在同一网络视角时才需要填写，例如容器内能解析的地址。
# 这不是生产 GitLab 地址，也不能带用户名或口令。
GIT_CLONE_BASE_URL=
GIT_TOKEN=
GIT_TIMEOUT_SECONDS=30

# 可选依赖代理。全部留空则不连接，产品构建与未配置时相同。
# 走通一次构建时这些变量保持留空。制品仍只保存在 KILN_ARTIFACT_ROOT，不会发布到 Nexus。
# 不要把真实口令写进仓库。地址不能带用户名或口令。
KILN_NEXUS_URL=
KILN_NEXUS_REPOSITORY=
# Jenkins 看到的依赖代理地址。留空则使用 KILN_NEXUS_URL。
KILN_NEXUS_BUILD_URL=
KILN_NEXUS_USERNAME=
KILN_NEXUS_PASSWORD=
KILN_NEXUS_TIMEOUT_SECONDS=10

# 平台自管的制品字节目录。相对路径按进程工作目录解析。
# 这是本地目录，不是 Nexus。制品不会发布到 Nexus。
KILN_ARTIFACT_ROOT=var/kiln-artifacts
KILN_ARTIFACT_MAX_BYTES=67108864

# 用户信息同步。全部留空则只使用本地口令登录。
# 任一项必填变量有值时，下列必填项都必须有值。
# 不要把公司用户系统的地址或密钥写进仓库。
KILN_OIDC_ISSUER_URL=
KILN_OIDC_CLIENT_ID=
KILN_OIDC_CLIENT_SECRET=
KILN_OIDC_REDIRECT_URI=
KILN_OIDC_EMPLOYMENT_CLAIM=
KILN_OIDC_EMPLOYMENT_ACTIVE_VALUES=
# 仅在上面已配置时生效。留空则使用 openid profile email。
KILN_OIDC_SCOPES=
# 用户会话。默认 12 小时。Secure 只在明确配置时打开。
KILN_SESSION_TTL_SECONDS=43200
KILN_SESSION_COOKIE_SECURE=false
