# 复制为 .env 后按本地环境修改。不要把真实密钥写进仓库。
# .env 已被 git 忽略。下列口令只是本地开发默认值，不能用于生产。

KILN_ENV=local
KILN_HTTP_HOST=0.0.0.0
KILN_HTTP_PORT=8000
KILN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# API 启动时连接该库并执行迁移。此默认值与 docker compose 中的本地 Postgres 对齐。
DATABASE_URL=postgresql://kiln:kiln@localhost:5432/kiln

# 调用 /api/v1 时放在 Authorization: Bearer 头里。
# kiln-local 只用于本地开发和 CI，不能用于生产。留空时 API 拒绝启动。
KILN_API_TOKEN=kiln-local
POSTGRES_USER=kiln
POSTGRES_PASSWORD=kiln
POSTGRES_DB=kiln

# openai：调用 LLM_BASE_URL 上的 OpenAI 兼容 /chat/completions
# mock：本地固定回复，不访问网络
# off：关闭模型（none、disabled 同样视为关闭）
LLM_PROVIDER=off
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Jenkins 兼容执行器。三项都留空则不连接，API 仍能启动。
# 不要把真实令牌写进仓库。URL 不能带用户名或口令。
# 共享实验机上已经在跑的 Jenkins 是 http://127.0.0.1:8080 ，口令不在本文件里。
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_TIMEOUT_SECONDS=30

# 代码源适配器。off 表示不连接。
# gitea：实验室实现。gitlab：生产代码源。仓库不提供这两处的生产地址。
# 共享实验机上已经在跑的 Gitea 是 http://127.0.0.1:3000 ，令牌不在本文件里。
GIT_PROVIDER=off
GIT_BASE_URL=
GIT_TOKEN=
GIT_TIMEOUT_SECONDS=30

# 平台自管的制品字节目录。相对路径按进程工作目录解析。
# 这是本地目录，不是 Nexus。这一版没有 Nexus 地址。
KILN_ARTIFACT_ROOT=var/kiln-artifacts
KILN_ARTIFACT_MAX_BYTES=67108864
